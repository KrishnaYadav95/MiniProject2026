rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Admin Credentials Database Collection
    // Allows reading and updating administrator credentials for authentication and management
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId);
    }

    // Customers and Store Users
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Connection testing doc
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
